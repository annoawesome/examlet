# Supply-chain hardening. See ARCHITECTURE.md → "Supply-chain security".

# Never run dependency lifecycle scripts (preinstall/postinstall are the
# most common malware vector). Our own scripts still run via `npm run`.
ignore-scripts=true

# Pin exact versions so a compromised patch release can't sneak in.
save-exact=true

# Always use and honour the lockfile (integrity hashes for every tarball).
package-lock=true

# Only talk to the official registry, over TLS.
registry=https://registry.npmjs.org/
strict-ssl=true

# Fail fast on unsupported Node versions; keep audit on.
engine-strict=true
audit=true
audit-level=high
fund=false
